{
  "config_section": {
    "description": "配置分类",
    "type": "string",
    "default": "基础配置",
    "options": [
      "基础配置",
      "自动模型",
      "情绪感知",
      "文本处理",
      "分段发送",
      "触发策略",
      "预热"
    ],
    "hint": "基础配置只保留连接和默认行为；角色、语言、情绪和音色目录默认由 Gateway 自动获取。"
  },
  "base_url": {
    "description": "Genie TTS Gateway 地址",
    "type": "string",
    "default": "http://127.0.0.1:19880",
    "hint": "例如 http://127.0.0.1:19880"
  },
  "api_key": {
    "description": "API Key（X-API-Key）",
    "type": "string",
    "default": "",
    "hint": "必填，否则不会自动 TTS"
  },
  "basic": {
    "description": "连接后的默认行为",
    "type": "object",
    "condition": {
      "config_section": "基础配置"
    },
    "hint": "默认角色、语言和情绪由 Gateway 目录自动维护；手动选择可用 gentts set global_*。",
    "items": {
      "character": {
        "description": "默认角色",
        "type": "string",
        "default": "auto",
        "hint": "auto = 从 Gateway 目录选择 is_default 角色；需要固定时填写角色名，角色列表可用 gentts characters 查看。"
      },
      "language": {
        "description": "默认语言",
        "type": "string",
        "default": "auto",
        "options": [
          "auto",
          "zh",
          "en",
          "hybrid"
        ],
        "hint": "auto = 使用所选角色默认参考音频的语言。"
      },
      "save_on_server": {
        "description": "在服务端保存音频",
        "type": "bool",
        "default": false
      },
      "timeout": {
        "description": "HTTP 超时（秒）",
        "type": "int",
        "default": 300
      },
      "retry_attempts": {
        "description": "失败重试次数",
        "type": "int",
        "default": 3
      },
      "auto_check_on_start": {
        "description": "启动时检查 Gateway 并同步音色",
        "type": "bool",
        "default": true
      }
    }
  },
  "voices": {
    "description": "Gateway 自动同步的音色与情绪路由",
    "type": "template_list",
    "condition": {
      "config_section": "自动模型"
    },
    "hint": "由启动连接或 gentts sync 自动写入。不要手工填写 emotion_routes；仅在需要自定义语义映射时编辑后使用 gentts sync force 覆盖。",
    "default": [],
    "templates": {
      "voice": {
        "name": "音色/模型",
        "display_item": "character",
        "items": {
          "character": {
            "description": "模型/角色名",
            "type": "string",
            "hint": "如 lxh / manbo / feibi",
            "default": "lxh"
          },
          "enabled": {
            "description": "启用此音色配置",
            "type": "bool",
            "default": true
          },
          "language": {
            "description": "该角色默认语言",
            "type": "string",
            "options": [
              "zh",
              "en",
              "hybrid"
            ],
            "default": "zh"
          },
          "default_emotion_id": {
            "description": "默认情绪 ID",
            "type": "int",
            "default": 0
          },
          "default_emotion": {
            "description": "默认情绪名",
            "type": "string",
            "default": ""
          },
          "emotion_routes": {
            "description": "情绪感知映射",
            "type": "template_list",
            "default": [],
            "hint": "感知标签建议使用：开心/悲伤/生气/兴奋/平静/困惑/无聊/好奇/惊讶/焦虑",
            "templates": {
              "route": {
                "name": "情绪映射",
                "display_item": "label",
                "items": {
                  "label": {
                    "description": "感知情绪标签",
                    "type": "string",
                    "hint": "如 开心/悲伤/生气/平静",
                    "default": "平静"
                  },
                  "aliases": {
                    "description": "别名（逗号分隔）",
                    "type": "string",
                    "hint": "例如：高兴,快乐,愉悦",
                    "default": ""
                  },
                  "emotion_id": {
                    "description": "映射到网关情绪 ID",
                    "type": "int",
                    "hint": "优先使用 ID；0 则用情绪名",
                    "default": 0
                  },
                  "emotion": {
                    "description": "映射到网关情绪名",
                    "type": "string",
                    "default": ""
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "model_select": {
    "description": "自动模型目录同步",
    "type": "object",
    "condition": {
      "config_section": "自动模型"
    },
    "items": {
      "auto_sync_voices": {
        "description": "连接网关后自动补齐新增音色",
        "type": "bool",
        "default": true,
        "hint": "从 Gateway 获取角色与情绪，写入 voices 配置；默认不覆盖手工映射"
      },
      "overwrite_on_sync": {
        "description": "同步时覆盖已有 voices 映射",
        "type": "bool",
        "default": false
      }
    },
    "hint": "自动同步只补齐 Gateway 新模型并保留手工映射；强制同步会按当前目录重建模板。"
  },
  "emotion_detect": {
    "description": "情绪检测与路由",
    "type": "object",
    "condition": {
      "config_section": "情绪感知"
    },
    "hint": "关键词 / LLM / 混合；识别结果会映射到 voices 情绪路由",
    "items": {
      "enabled": {
        "description": "启用情绪感知",
        "type": "bool",
        "default": true
      },
      "mode": {
        "description": "识别模式",
        "type": "string",
        "default": "hybrid",
        "options": [
          "keyword",
          "llm",
          "hybrid"
        ],
        "hint": "也支持：关键词/大模型/混合 等别名"
      },
      "provider_id": {
        "description": "情绪识别用的 LLM Provider ID（可空=默认）",
        "type": "string",
        "default": ""
      },
      "labels": {
        "description": "可识别情绪标签（逗号分隔）",
        "type": "string",
        "default": "开心,悲伤,生气,兴奋,平静,困惑,无聊,好奇,惊讶,焦虑,默认"
      },
      "keyword_threshold": {
        "description": "关键词置信阈值（hybrid/keyword）",
        "type": "float",
        "default": 0.55
      },
      "smooth": {
        "description": "会话情绪平滑（减少乱跳）",
        "type": "bool",
        "default": true
      },
      "timeout": {
        "description": "LLM 识别超时（秒）",
        "type": "int",
        "default": 12
      },
      "fallback_label": {
        "description": "识别失败回退标签",
        "type": "string",
        "default": "默认"
      },
      "llm_api_base": {
        "description": "LLM API 地址（可选，留空使用 AstrBot 默认 LLM）",
        "type": "string",
        "hint": "例如 https://api-test.pie-xian.com/v1",
        "default": ""
      },
      "llm_api_key": {
        "description": "LLM API Key（可选）",
        "type": "string",
        "default": ""
      },
      "llm_model": {
        "description": "LLM 模型名（可选，默认 gemini-2.5-flash）",
        "type": "string",
        "hint": "例如 gemini-2.5-flash",
        "default": ""
      }
    }
  },
  "filter": {
    "description": "文本清洗",
    "type": "object",
    "condition": {
      "config_section": "文本处理"
    },
    "hint": "代码/表情/链接/Markdown/颜文字/替换词/静音裁剪",
    "items": {
      "filter_code": {
        "description": "过滤代码块",
        "type": "bool",
        "default": true
      },
      "filter_emoji": {
        "description": "过滤 Emoji / QQ 表情",
        "type": "bool",
        "default": true
      },
      "filter_url": {
        "description": "过滤链接与路径",
        "type": "bool",
        "default": true
      },
      "filter_markdown": {
        "description": "过滤 Markdown 标记",
        "type": "bool",
        "default": true
      },
      "filter_kaomoji": {
        "description": "过滤颜文字",
        "type": "bool",
        "default": true
      },
      "clean_before_items": {
        "description": "额外删除词（精确子串）",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        }
      },
      "replacement_words": {
        "description": "替换词（原词|新词）",
        "type": "list",
        "default": [
          "233|哈哈哈",
          "666|厉害",
          "555|呜呜呜"
        ],
        "items": {
          "type": "string"
        }
      },
      "kaomoji_words": {
        "description": "颜文字关键词",
        "type": "list",
        "default": [
          "ω",
          "Ω",
          "σ",
          "Σ",
          "ε",
          "д",
          "Д",
          "orz",
          "OTZ",
          "QAQ",
          "QWQ",
          "TAT",
          "TUT",
          "www"
        ],
        "items": {
          "type": "string"
        }
      },
      "max_repeat_count": {
        "description": "连续重复字符上限（0=不限制）",
        "type": "int",
        "default": 2
      },
      "trim_silence": {
        "description": "裁剪音频首尾静音（需 pydub）",
        "type": "bool",
        "default": true
      },
      "replace_text": {
        "description": "用语音替换原文本",
        "type": "bool",
        "default": true
      }
    }
  },
  "split": {
    "description": "分段、断句与消息投递",
    "type": "object",
    "condition": {
      "config_section": "分段发送"
    },
    "hint": "只按完整句末标点切分；短句不合并，超过原 max_segments 也不会把多句合并。每句按顺序单独 TTS。",
    "items": {
      "enabled": {
        "description": "启用分段",
        "type": "bool",
        "default": true
      },
      "split_chars": {
        "description": "句末标点",
        "type": "list",
        "default": [
          "。",
          "？",
          "！",
          "?",
          "!",
          "…",
          "."
        ],
        "items": {
          "type": "string"
        }
      },
      "protect_pairs": {
        "description": "保护未闭合引号/括号内不分段",
        "type": "bool",
        "default": true
      },
      "send_speed": {
        "description": "段间发送速度",
        "type": "string",
        "default": "自然",
        "options": [
          "自然",
          "快速",
          "慢速",
          "固定",
          "随机"
        ],
        "hint": "也支持 fast/slow/natural 等英文别名"
      },
      "send_text_with_audio": {
        "description": "发送文本与音频",
        "type": "bool",
        "default": false
      }
    }
  },
  "warmup": {
    "description": "预热",
    "type": "object",
    "condition": {
      "config_section": "预热"
    },
    "hint": "模型休眠时文本降级，热机后恢复 TTS",
    "items": {
      "enabled": {
        "description": "启用预热降级",
        "type": "bool",
        "default": true
      },
      "show_tip": {
        "description": "预热时附加提示文案",
        "type": "bool",
        "default": false
      },
      "status_ttl": {
        "description": "状态缓存秒数",
        "type": "int",
        "default": 8
      }
    }
  },
  "trigger": {
    "description": "自动播报触发策略",
    "type": "object",
    "condition": {
      "config_section": "触发策略"
    },
    "hint": "全局启用时使用禁用会话列表；全局关闭时使用启用会话列表。",
    "items": {
      "global_enable": {
        "description": "全局自动播报",
        "type": "bool",
        "default": true
      },
      "prob": {
        "description": "播报概率",
        "type": "float",
        "default": 1,
        "min": 0,
        "max": 1
      },
      "text_limit": {
        "description": "自动播报最大字符数（0=不限）",
        "type": "int",
        "default": 300,
        "min": 0
      },
      "cooldown": {
        "description": "同一会话冷却秒数",
        "type": "int",
        "default": 0,
        "min": 0
      }
    }
  }
}
