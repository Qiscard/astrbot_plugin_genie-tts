{
  "config_mode": {
    "description": "配置模式",
    "type": "string",
    "options": [
      "简易模式",
      "完整模式"
    ],
    "default": "简易模式",
    "hint": "简易：几个核心开关；完整：按「网关/音色/情绪/过滤/分段/预热/触发」分类精细配置。切换后请保存并重载。"
  },
  "base_url": {
    "description": "Gateway 地址",
    "type": "string",
    "default": "http://127.0.0.1:19880",
    "hint": "如 http://211.154.18.252:19880"
  },
  "api_key": {
    "description": "API Key",
    "type": "string",
    "default": ""
  },
  "simple_settings": {
    "description": "简易设置",
    "type": "object",
    "condition": {
      "config_mode": "简易模式"
    },
    "hint": "开箱即用。完整能力请切到完整模式。",
    "items": {
      "character": {
        "description": "默认角色",
        "type": "string",
        "default": "lxh"
      },
      "enable_auto_tts": {
        "description": "自动把 AI 回复转语音",
        "type": "bool",
        "default": true
      },
      "enable_emotion": {
        "description": "情绪识别自动切音色",
        "type": "bool",
        "default": true
      },
      "enable_split": {
        "description": "长回复分段发送",
        "type": "bool",
        "default": true
      },
      "max_segments": {
        "description": "最多几段",
        "type": "int",
        "default": 5
      },
      "send_speed": {
        "description": "发送节奏",
        "type": "string",
        "options": [
          "自然",
          "快速",
          "慢速"
        ],
        "default": "自然"
      },
      "enable_filter": {
        "description": "过滤颜文字/链接/代码等",
        "type": "bool",
        "default": true
      },
      "enable_warmup": {
        "description": "休眠时先发文本并后台预热",
        "type": "bool",
        "default": true
      },
      "text_limit": {
        "description": "超长跳过 TTS（0不限）",
        "type": "int",
        "default": 300
      }
    }
  },
  "gateway": {
    "description": "网关与合成",
    "type": "object",
    "condition": {
      "config_mode": "完整模式"
    },
    "items": {
      "character": {
        "description": "默认角色",
        "type": "string",
        "default": "lxh"
      },
      "language": {
        "description": "语言",
        "type": "string",
        "options": [
          "zh",
          "en",
          "hybrid"
        ],
        "default": "zh"
      },
      "emotion_id": {
        "description": "默认情绪ID",
        "type": "int",
        "default": 0
      },
      "emotion": {
        "description": "默认情绪名",
        "type": "string",
        "default": ""
      },
      "split_sentence": {
        "description": "服务端分句",
        "type": "bool",
        "default": true
      },
      "save_on_server": {
        "description": "服务端落盘",
        "type": "bool",
        "default": false
      },
      "timeout": {
        "description": "超时秒",
        "type": "int",
        "default": 300
      },
      "retry_attempts": {
        "description": "重试次数",
        "type": "int",
        "default": 3
      },
      "auto_check_on_start": {
        "description": "启动检查/同步音色",
        "type": "bool",
        "default": true
      }
    }
  },
  "voices": {
    "description": "音色配置（模型层叠）",
    "type": "template_list",
    "condition": {
      "config_mode": "完整模式"
    },
    "hint": "首次连接自动同步。每个模型下配置情绪感知映射。",
    "default": [],
    "templates": {
      "voice": {
        "name": "音色/模型",
        "display_item": "character",
        "items": {
          "character": {
            "description": "模型名",
            "type": "string",
            "default": "lxh"
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "language": {
            "description": "语言",
            "type": "string",
            "options": [
              "zh",
              "en",
              "hybrid"
            ],
            "default": "zh"
          },
          "default_emotion_id": {
            "description": "默认情绪ID",
            "type": "int",
            "default": 0
          },
          "default_emotion": {
            "description": "默认情绪名",
            "type": "string",
            "default": ""
          },
          "emotion_routes": {
            "description": "情绪感知映射",
            "type": "template_list",
            "default": [],
            "templates": {
              "route": {
                "name": "情绪映射",
                "display_item": "label",
                "items": {
                  "label": {
                    "description": "感知标签",
                    "type": "string",
                    "default": "平静",
                    "hint": "开心/悲伤/生气/兴奋/平静/..."
                  },
                  "aliases": {
                    "description": "别名(逗号)",
                    "type": "string",
                    "default": ""
                  },
                  "emotion_id": {
                    "description": "网关情绪ID",
                    "type": "int",
                    "default": 0
                  },
                  "emotion": {
                    "description": "网关情绪名",
                    "type": "string",
                    "default": ""
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "model_select": {
    "description": "模型同步",
    "type": "object",
    "condition": {
      "config_mode": "完整模式"
    },
    "items": {
      "auto_sync_voices": {
        "description": "首次自动同步音色",
        "type": "bool",
        "default": true
      },
      "auto_select_emotion": {
        "description": "切角色自动默认情绪",
        "type": "bool",
        "default": true
      },
      "overwrite_on_sync": {
        "description": "sync时覆盖已有映射",
        "type": "bool",
        "default": false
      }
    }
  },
  "emotion_detect": {
    "description": "LLM/关键词情绪感知",
    "type": "object",
    "condition": {
      "config_mode": "完整模式"
    },
    "hint": "参考 realistic-persona：关键词优先，LLM 兜底",
    "items": {
      "enabled": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "mode": {
        "description": "模式",
        "type": "string",
        "options": [
          "hybrid",
          "keyword",
          "llm"
        ],
        "default": "hybrid"
      },
      "provider_id": {
        "description": "LLM提供商ID(空=默认)",
        "type": "string",
        "default": ""
      },
      "labels": {
        "description": "标签",
        "type": "string",
        "default": "开心,悲伤,生气,兴奋,平静,困惑,无聊,好奇,惊讶,焦虑,默认"
      },
      "keyword_threshold": {
        "description": "关键词置信阈值",
        "type": "float",
        "default": 0.55
      },
      "smooth": {
        "description": "会话平滑",
        "type": "bool",
        "default": true
      },
      "timeout": {
        "description": "LLM超时秒",
        "type": "int",
        "default": 12
      },
      "fallback_label": {
        "description": "回退标签",
        "type": "string",
        "default": "默认"
      }
    }
  },
  "filter": {
    "description": "文本屏蔽/清洗",
    "type": "object",
    "condition": {
      "config_mode": "完整模式"
    },
    "hint": "借鉴 splitter 清理 + tts_sanitizer 颜文字",
    "items": {
      "filter_code": {
        "description": "过滤代码",
        "type": "bool",
        "default": true
      },
      "filter_emoji": {
        "description": "过滤Emoji/QQ表情",
        "type": "bool",
        "default": true
      },
      "filter_url": {
        "description": "过滤URL",
        "type": "bool",
        "default": true
      },
      "filter_markdown": {
        "description": "过滤Markdown",
        "type": "bool",
        "default": true
      },
      "filter_kaomoji": {
        "description": "过滤颜文字",
        "type": "bool",
        "default": true
      },
      "clean_before_items": {
        "description": "删除指定文本(每行一条)",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "replacement_words": {
        "description": "替换 原|新",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [
          "233|哈哈哈",
          "666|厉害",
          "555|呜呜呜"
        ]
      },
      "kaomoji_words": {
        "description": "颜文字删词",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [
          "ω",
          "Ω",
          "σ",
          "Σ",
          "ε",
          "д",
          "Д",
          "orz",
          "OTZ",
          "QAQ",
          "QWQ",
          "TAT",
          "TUT",
          "www"
        ]
      },
      "max_repeat_count": {
        "description": "重复字压缩(0关)",
        "type": "int",
        "default": 2
      },
      "trim_silence": {
        "description": "裁剪音频静音",
        "type": "bool",
        "default": true
      },
      "replace_text": {
        "description": "语音替换原文",
        "type": "bool",
        "default": true
      },
      "send_text_with_audio": {
        "description": "语音附带文本",
        "type": "bool",
        "default": false
      }
    }
  },
  "split": {
    "description": "分段发送（借鉴 splitter）",
    "type": "object",
    "condition": {
      "config_mode": "完整模式"
    },
    "hint": "长回复拆多段，按节奏发送；每段可单独合成语音",
    "items": {
      "enabled": {
        "description": "启用分段",
        "type": "bool",
        "default": true
      },
      "max_segments": {
        "description": "最多段数",
        "type": "int",
        "default": 5
      },
      "min_segment_length": {
        "description": "最短段长",
        "type": "int",
        "default": 8
      },
      "split_chars": {
        "description": "分段符号",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [
          "。",
          "？",
          "！",
          "?",
          "!",
          "；",
          ";",
          "\\n",
          "…"
        ]
      },
      "protect_pairs": {
        "description": "保护括号引号内不断开",
        "type": "bool",
        "default": true
      },
      "send_speed": {
        "description": "发送节奏",
        "type": "string",
        "options": [
          "自然",
          "快速",
          "慢速",
          "随机"
        ],
        "default": "自然"
      },
      "tts_each_segment": {
        "description": "每段都合成语音",
        "type": "bool",
        "default": true
      }
    }
  },
  "warmup": {
    "description": "预热模式",
    "type": "object",
    "condition": {
      "config_mode": "完整模式"
    },
    "items": {
      "enabled": {
        "description": "休眠时文本降级+预热",
        "type": "bool",
        "default": true
      },
      "show_tip": {
        "description": "附加预热提示",
        "type": "bool",
        "default": false
      },
      "status_ttl": {
        "description": "状态缓存秒",
        "type": "int",
        "default": 8
      }
    }
  },
  "trigger": {
    "description": "触发控制",
    "type": "object",
    "condition": {
      "config_mode": "完整模式"
    },
    "items": {
      "global_enable": {
        "description": "全局开(黑名单)/关(白名单)",
        "type": "bool",
        "default": true
      },
      "prob": {
        "description": "触发概率",
        "type": "float",
        "default": 1.0
      },
      "text_limit": {
        "description": "长度上限(0不限)",
        "type": "int",
        "default": 300
      },
      "cooldown": {
        "description": "冷却秒",
        "type": "int",
        "default": 0
      }
    }
  }
}
