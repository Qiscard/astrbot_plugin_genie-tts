{
  "config_section": {
    "description": "配置分类（切换查看不同功能模块）",
    "type": "string",
    "default": "基础配置",
    "options": ["基础配置", "音色模型", "情绪感知", "过滤处理", "分段发送", "预热触发"],
    "hint": "按功能分类管理，不再使用简易/完整模式"
  },
  "base_url": {
    "description": "Genie TTS Gateway 地址",
    "type": "string",
    "default": "http://127.0.0.1:19880",
    "hint": "例如 http://127.0.0.1:19880"
  },
  "api_key": {
    "description": "API Key（X-API-Key）",
    "type": "string",
    "default": "",
    "hint": "必填，否则不会自动 TTS"
  },
  "basic": {
    "description": "基础配置",
    "type": "object",
    "condition": { "config_section": "基础配置" },
    "hint": "角色、语言、触发概率、冷却等",
    "items": {
      "character": {
        "description": "默认角色/模型名",
        "type": "string",
        "default": "lxh",
        "hint": "支持模糊匹配，如 LXH / lxh"
      },
      "language": {
        "description": "语言",
        "type": "string",
        "default": "zh",
        "options": ["zh", "en", "hybrid"],
        "hint": "也支持中文/英文/双语等别名输入"
      },
      "emotion_id": {
        "description": "默认情绪 ID（0=默认）",
        "type": "int",
        "default": 0
      },
      "emotion": {
        "description": "默认情绪名（可空）",
        "type": "string",
        "default": "",
        "hint": "支持别名：开心/高兴/happy 等"
      },
      "split_sentence": {
        "description": "Gateway 侧分句合成",
        "type": "bool",
        "default": true
      },
      "save_on_server": {
        "description": "在服务端保存音频",
        "type": "bool",
        "default": false
      },
      "timeout": {
        "description": "HTTP 超时（秒）",
        "type": "int",
        "default": 300
      },
      "retry_attempts": {
        "description": "失败重试次数",
        "type": "int",
        "default": 3
      },
      "auto_check_on_start": {
        "description": "启动时检查 Gateway 并同步音色",
        "type": "bool",
        "default": true
      },
      "enable_auto_tts": {
        "description": "启用自动 TTS（装饰 LLM 回复）",
        "type": "bool",
        "default": true
      },
      "global_enable": {
        "description": "全局默认启用（黑名单模式）",
        "type": "bool",
        "default": true,
        "hint": "开=默认启用可用 off 禁用；关=默认禁用可用 on 启用"
      },
      "prob": {
        "description": "自动 TTS 触发概率 0~1",
        "type": "float",
        "default": 1.0
      },
      "text_limit": {
        "description": "超过此字数不自动 TTS（0=不限制）",
        "type": "int",
        "default": 300
      },
      "cooldown": {
        "description": "同一会话冷却秒数",
        "type": "int",
        "default": 0
      }
    }
  },
  "voices": {
    "description": "层叠音色（按模型配置情绪映射）",
    "type": "template_list",
    "condition": { "config_section": "音色模型" },
    "hint": "首次启动可自动从 Gateway 同步；每个模型单独配置情绪路由",
    "config_template": {
      "character": {
        "description": "模型/角色名",
        "type": "string",
        "default": "lxh"
      },
      "enabled": {
        "description": "启用此音色配置",
        "type": "bool",
        "default": true
      },
      "language": {
        "description": "该角色默认语言",
        "type": "string",
        "default": "zh",
        "options": ["zh", "en", "hybrid"]
      },
      "default_emotion_id": {
        "description": "默认情绪 ID",
        "type": "int",
        "default": 0
      },
      "default_emotion": {
        "description": "默认情绪名",
        "type": "string",
        "default": ""
      },
      "emotion_routes": {
        "description": "情绪感知映射",
        "type": "list",
        "default": [],
        "hint": "支持 dict 或字符串：开心->4:标准 / 悲伤|2|低落",
        "items": {
          "type": "object",
          "items": {
            "label": {
              "description": "感知标签（开心/悲伤/...）",
              "type": "string",
              "default": "开心"
            },
            "aliases": {
              "description": "别名（逗号分隔）",
              "type": "string",
              "default": ""
            },
            "emotion_id": {
              "description": "映射到的情绪 ID",
              "type": "int",
              "default": 0
            },
            "emotion": {
              "description": "映射到的情绪名",
              "type": "string",
              "default": ""
            }
          }
        }
      }
    }
  },
  "model_select": {
    "description": "模型同步",
    "type": "object",
    "condition": { "config_section": "音色模型" },
    "items": {
      "auto_sync_voices": {
        "description": "启动时自动同步音色列表",
        "type": "bool",
        "default": true
      },
      "auto_select_emotion": {
        "description": "切换角色时自动选默认情绪",
        "type": "bool",
        "default": true
      },
      "overwrite_on_sync": {
        "description": "同步时覆盖已有 voices 映射",
        "type": "bool",
        "default": false
      }
    }
  },
  "emotion_detect": {
    "description": "LLM 情绪感知",
    "type": "object",
    "condition": { "config_section": "情绪感知" },
    "hint": "关键词 / LLM / 混合；识别结果会映射到 voices 情绪路由",
    "items": {
      "enabled": {
        "description": "启用情绪感知",
        "type": "bool",
        "default": true
      },
      "mode": {
        "description": "识别模式",
        "type": "string",
        "default": "hybrid",
        "options": ["keyword", "llm", "hybrid"],
        "hint": "也支持：关键词/大模型/混合 等别名"
      },
      "provider_id": {
        "description": "情绪识别用的 LLM Provider ID（可空=默认）",
        "type": "string",
        "default": ""
      },
      "labels": {
        "description": "可识别情绪标签（逗号分隔）",
        "type": "string",
        "default": "开心,悲伤,生气,兴奋,平静,困惑,无聊,好奇,惊讶,焦虑,默认"
      },
      "keyword_threshold": {
        "description": "关键词置信阈值（hybrid/keyword）",
        "type": "float",
        "default": 0.55
      },
      "smooth": {
        "description": "会话情绪平滑（减少乱跳）",
        "type": "bool",
        "default": true
      },
      "timeout": {
        "description": "LLM 识别超时（秒）",
        "type": "int",
        "default": 12
      },
      "fallback_label": {
        "description": "识别失败回退标签",
        "type": "string",
        "default": "默认"
      }
    }
  },
  "filter": {
    "description": "过滤处理",
    "type": "object",
    "condition": { "config_section": "过滤处理" },
    "hint": "代码/表情/链接/Markdown/颜文字/替换词/静音裁剪",
    "items": {
      "filter_code": {
        "description": "过滤代码块",
        "type": "bool",
        "default": true
      },
      "filter_emoji": {
        "description": "过滤 Emoji / QQ 表情",
        "type": "bool",
        "default": true
      },
      "filter_url": {
        "description": "过滤链接与路径",
        "type": "bool",
        "default": true
      },
      "filter_markdown": {
        "description": "过滤 Markdown 标记",
        "type": "bool",
        "default": true
      },
      "filter_kaomoji": {
        "description": "过滤颜文字",
        "type": "bool",
        "default": true
      },
      "clean_before_items": {
        "description": "额外删除词（精确子串）",
        "type": "list",
        "default": [],
        "items": { "type": "string" }
      },
      "replacement_words": {
        "description": "替换词（原词|新词）",
        "type": "list",
        "default": ["233|哈哈哈", "666|厉害", "555|呜呜呜"],
        "items": { "type": "string" }
      },
      "kaomoji_words": {
        "description": "颜文字关键词",
        "type": "list",
        "default": ["ω", "Ω", "σ", "Σ", "ε", "д", "Д", "orz", "OTZ", "QAQ", "QWQ", "TAT", "TUT", "www"],
        "items": { "type": "string" }
      },
      "max_repeat_count": {
        "description": "连续重复字符上限（0=不限制）",
        "type": "int",
        "default": 2
      },
      "trim_silence": {
        "description": "裁剪音频首尾静音（需 pydub）",
        "type": "bool",
        "default": true
      },
      "replace_text": {
        "description": "用语音替换原文本",
        "type": "bool",
        "default": true
      },
      "send_text_with_audio": {
        "description": "语音同时附带文本",
        "type": "bool",
        "default": false
      }
    }
  },
  "split": {
    "description": "分段发送",
    "type": "object",
    "condition": { "config_section": "分段发送" },
    "hint": "借鉴 splitter：按句切分、延迟、逐段 TTS",
    "items": {
      "enabled": {
        "description": "启用分段",
        "type": "bool",
        "default": true
      },
      "max_segments": {
        "description": "最大段数",
        "type": "int",
        "default": 5
      },
      "min_segment_length": {
        "description": "过短段合并阈值（字）",
        "type": "int",
        "default": 8
      },
      "split_chars": {
        "description": "分段分隔符",
        "type": "list",
        "default": ["。", "？", "！", "?", "!", "；", ";", "\\n", "…"],
        "items": { "type": "string" }
      },
      "protect_pairs": {
        "description": "保护未闭合引号/括号内不分段",
        "type": "bool",
        "default": true
      },
      "send_speed": {
        "description": "段间发送速度",
        "type": "string",
        "default": "自然",
        "options": ["自然", "快速", "慢速", "固定", "随机"],
        "hint": "也支持 fast/slow/natural 等英文别名"
      },
      "tts_each_segment": {
        "description": "每一段都合成语音",
        "type": "bool",
        "default": true,
        "hint": "关闭则整段一次合成"
      }
    }
  },
  "warmup": {
    "description": "预热",
    "type": "object",
    "condition": { "config_section": "预热触发" },
    "hint": "模型休眠时文本降级，热机后恢复 TTS",
    "items": {
      "enabled": {
        "description": "启用预热降级",
        "type": "bool",
        "default": true
      },
      "show_tip": {
        "description": "预热时附加提示文案",
        "type": "bool",
        "default": false
      },
      "status_ttl": {
        "description": "状态缓存秒数",
        "type": "int",
        "default": 8
      }
    }
  }
}
